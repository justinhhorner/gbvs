{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "command": "${workspaceFolder}/build.bat",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "bgb.exe",
      "args": ["--rom", "game.gb", "--watch"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
